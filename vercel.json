{
  "rewrites": [
    {
      "source": "/ghostcall",
      "destination": "https://ghost-call-theta.vercel.app"
    },
    {
      "source": "/ghostcall/:path*",
      "destination": "https://ghost-call-theta.vercel.app/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://ghost-call-theta.vercel.app/_next/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}